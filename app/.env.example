# Database configuration (PostgreSQL with pgvector or Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/articol"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only write configuration. Prefer the new secret key; never expose it.
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY=""

# Optional External API Keys for Candidate Generation & Enrichment
LASTFM_API_KEY=""
DISCOGS_USER_TOKEN=""

# iTunes Search Defaults
DEFAULT_ITUNES_COUNTRY="PH"

# Internal Indexing API Secret (for POST /api/albums/{collectionId}/index)
INDEXING_SECRET=""
